{
  "name": "codegraph-navigator",
  "displayName": "CodeGraph Navigator",
  "description": "Explore CodeGraph scenarios, walk through traced execution paths, browse code walks as notebook-style cells, and inspect functions — all from the VS Code sidebar.",
  "version": "0.5.0",
  "publisher": "codegraph",
  "repository": {
    "type": "git",
    "url": "https://github.com/codegraph/code-graph"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.codegraph.yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codegraph-navigator",
          "title": "CodeGraph v0.5.0",
          "icon": "media/codegraph-icon.svg"
        },
        {
          "id": "codegraph-codewalk",
          "title": "Code Walk",
          "icon": "media/codegraph-icon.svg"
        }
      ]
    },
    "views": {
      "codegraph-navigator": [
        {
          "id": "codegraph.scenarios",
          "name": "Scenarios"
        },
        {
          "id": "codegraph.stepWalker",
          "name": "Step Walker"
        },
        {
          "id": "codegraph.stepDetail",
          "name": "Step Detail",
          "type": "webview"
        },
        {
          "id": "codegraph.callStack",
          "name": "Call Stack",
          "type": "webview"
        },
        {
          "id": "codegraph.functions",
          "name": "Functions"
        }
      ],
      "codegraph-codewalk": [
        {
          "id": "codegraph.codeWalkCells",
          "name": "Code Walk Cells",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codegraph.showViewer",
        "title": "CodeGraph: Show Code Graph Viewer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codegraph.showOutput",
        "title": "CodeGraph: Show Output Log"
      },
      {
        "command": "codegraph.refreshScenarios",
        "title": "CodeGraph: Refresh Scenarios",
        "icon": "$(refresh)"
      },
      {
        "command": "codegraph.viewScenario",
        "title": "CodeGraph: View Scenario"
      },
      {
        "command": "codegraph.walkScenario",
        "title": "CodeGraph: Walk Scenario"
      },
      {
        "command": "codegraph.nextStep",
        "title": "CodeGraph: Next Step",
        "icon": "$(arrow-down)"
      },
      {
        "command": "codegraph.prevStep",
        "title": "CodeGraph: Previous Step",
        "icon": "$(arrow-up)"
      },
      {
        "command": "codegraph.openStepInEditor",
        "title": "CodeGraph: Open Step in Editor"
      },
      {
        "command": "codegraph.openCallStackFrame",
        "title": "CodeGraph: Open Call Stack Frame in Editor"
      },
      {
        "command": "codegraph.refreshFunctions",
        "title": "CodeGraph: Refresh Functions",
        "icon": "$(refresh)"
      },
      {
        "command": "codegraph.showScenariosForFunction",
        "title": "CodeGraph: Show Scenarios for Function"
      },
      {
        "command": "codegraph.discoverFromFunction",
        "title": "CodeGraph: Discover Scenarios from Function"
      },
      {
        "command": "codegraph.showScenariosForSymbol",
        "title": "CodeGraph: Show Scenarios for This Function",
        "enablement": "editorHasSelection || editorTextFocus"
      },
      {
        "command": "codegraph.discoverFromSymbol",
        "title": "CodeGraph: Discover Scenarios Starting from This Function",
        "enablement": "editorHasSelection || editorTextFocus"
      },
      {
        "command": "codegraph.findCallers",
        "title": "CodeGraph: Find Callers",
        "enablement": "editorHasSelection || editorTextFocus"
      },
      {
        "command": "codegraph.findCallees",
        "title": "CodeGraph: Find Callees",
        "enablement": "editorHasSelection || editorTextFocus"
      },
      {
        "command": "codegraph.searchFunctions",
        "title": "CodeGraph: Search Functions",
        "icon": "$(search)"
      },
      {
        "command": "codegraph.traceScenario",
        "title": "CodeGraph: Trace Scenario",
        "icon": "$(debug-start)"
      },
      {
        "command": "codegraph.filterScenarios",
        "title": "CodeGraph: Filter Scenarios by Tags",
        "icon": "$(filter)"
      },
      {
        "command": "codegraph.addTags",
        "title": "CodeGraph: Add Tags to Scenario"
      },
      {
        "command": "codegraph.setTags",
        "title": "CodeGraph: Set Tags on Scenario"
      },
      {
        "command": "codegraph.openCodeWalk",
        "title": "CodeGraph: Open Code Walk",
        "icon": "$(notebook)"
      },
      {
        "command": "codegraph.openCodeWalkById",
        "title": "CodeGraph: Open Code Walk by ID"
      },
      {
        "command": "codegraph.nextCell",
        "title": "CodeGraph: Next Cell",
        "icon": "$(arrow-down)"
      },
      {
        "command": "codegraph.prevCell",
        "title": "CodeGraph: Previous Cell",
        "icon": "$(arrow-up)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codegraph.refreshScenarios",
          "when": "view == codegraph.scenarios",
          "group": "navigation@1"
        },
        {
          "command": "codegraph.filterScenarios",
          "when": "view == codegraph.scenarios",
          "group": "navigation@2"
        },
        {
          "command": "codegraph.nextStep",
          "when": "view == codegraph.stepWalker",
          "group": "navigation@2"
        },
        {
          "command": "codegraph.prevStep",
          "when": "view == codegraph.stepWalker",
          "group": "navigation@1"
        },
        {
          "command": "codegraph.refreshFunctions",
          "when": "view == codegraph.functions",
          "group": "navigation"
        },
        {
          "command": "codegraph.searchFunctions",
          "when": "view == codegraph.functions",
          "group": "navigation"
        },
        {
          "command": "codegraph.nextCell",
          "when": "view == codegraph.codeWalkCells",
          "group": "navigation@2"
        },
        {
          "command": "codegraph.prevCell",
          "when": "view == codegraph.codeWalkCells",
          "group": "navigation@1"
        },
        {
          "command": "codegraph.openCodeWalk",
          "when": "view == codegraph.codeWalkCells",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "codegraph.viewScenario",
          "when": "view == codegraph.scenarios && viewItem == scenario",
          "group": "inline"
        },
        {
          "command": "codegraph.walkScenario",
          "when": "view == codegraph.scenarios && viewItem == scenario"
        },
        {
          "command": "codegraph.traceScenario",
          "when": "view == codegraph.scenarios && viewItem == scenario"
        },
        {
          "command": "codegraph.openCodeWalk",
          "when": "view == codegraph.scenarios && viewItem == scenario"
        },
        {
          "command": "codegraph.addTags",
          "when": "view == codegraph.scenarios && viewItem == scenario"
        },
        {
          "command": "codegraph.setTags",
          "when": "view == codegraph.scenarios && viewItem == scenario"
        },
        {
          "command": "codegraph.openStepInEditor",
          "when": "view == codegraph.stepWalker && viewItem == step",
          "group": "inline"
        },
        {
          "command": "codegraph.showScenariosForFunction",
          "when": "view == codegraph.functions && viewItem == function"
        },
        {
          "command": "codegraph.discoverFromFunction",
          "when": "view == codegraph.functions && viewItem == function"
        }
      ],
      "editor/context": [
        {
          "command": "codegraph.showScenariosForSymbol",
          "group": "codegraph@1",
          "when": "editorTextFocus"
        },
        {
          "command": "codegraph.discoverFromSymbol",
          "group": "codegraph@2",
          "when": "editorTextFocus"
        },
        {
          "command": "codegraph.findCallers",
          "group": "codegraph@3",
          "when": "editorTextFocus"
        },
        {
          "command": "codegraph.findCallees",
          "group": "codegraph@4",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "CodeGraph Navigator",
      "properties": {
        "codegraph.autoOpenStep": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the source file when stepping through a scenario."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p tsconfig.json",
    "bundle": "node esbuild.mjs",
    "build": "npm run compile && npm run bundle",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src --ext ts",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@codegraph/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.3"
  }
}
