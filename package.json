{
  "name": "code-graph",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted code understanding through graph-based call-path analysis",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/server",
    "packages/web",
    "codegraph-navigator"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "cd packages/core && npm test",
    "test:integration": "cd packages/core && npm run test:integration",
    "test:e2e": "cd test/e2e && npx vitest run",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "clean": "rm -rf packages/*/dist packages/*/node_modules/.cache",
    "codegraph": "node packages/cli/dist/index.js",
    "cgrun": "./scripts/cgrun"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
